//
//  env.example.xcconfig
//  immichSlides
//
//  Copy to Config/env.xcconfig for local server and debug settings.
//

// The empty $() expansion prevents // from starting an xcconfig comment.
IMMICH_SERVER_URL = https:/$()/your-server.example.com/api
IMMICH_API_KEY = YOUR_API_KEY
ENABLE_DEBUG_AUTO_SERVER = 0
ENABLE_DEBUG_FILL_APIKEY_BUTTON = 0
ENABLE_DEBUG_SETTINGS_ENTRY = 0
ENABLE_DEBUG_FORCE_SINGLE_PHOTO_PLAYBACK = 0
