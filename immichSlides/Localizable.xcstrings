    "The server rejected this API Key. Make sure you copied the full new API Key, not the Key name or an old Key." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor rechazó esta API Key. Asegúrate de haber copiado la API Key nueva completa, no el nombre de la API Key ni una API Key anterior."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがこの API Key を拒否しました。Key 名や古い Key ではなく、新しい API Key 全体をコピーしたことを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器拒绝了这个 API Key。请确认复制的是完整的新 API Key，而不是 Key 名称或旧 Key。"
          }
        },
        "zh-Hant-HK" : {
