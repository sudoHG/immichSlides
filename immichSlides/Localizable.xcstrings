    "Manage playback, access protection, server connection, and cache in one workspace designed for the remote." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administre la reproducción, la protección de acceso, la conexión del servidor y el caché en un espacio de trabajo diseñado para el control remoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモート用に設計された 1 つのワークスペースで、再生、アクセス保護、サーバー接続、キャッシュを管理します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把播放器、访问保护、服务器连接和缓存管理收拢到同一个遥控器友好的工作区。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將播放器、存取保護、伺服器連線及快取管理集中在同一個適合遙控器操作的工作區。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把播放器、存取保護、伺服器連線和快取管理收攏到同一個遙控器友善的工作區。"
          }
        }
      }
    },
    "Manage playback, access protection, server, and cache." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
