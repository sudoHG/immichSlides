    "The API Key is stored in Apple Keychain. Never send it to support by email." : {
      "comment" : "API Key help sheet security guidance.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La API Key se guarda en el llavero de Apple. No la envíes por correo al equipo de soporte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key は Apple Keychain に保存されます。サポート窓口へメールで送信しないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key 会保存在 Apple Keychain 中；请不要把它发给支持邮箱。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key 會儲存在 Apple 鑰匙圈；請勿透過電郵傳送給支援團隊。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key 會儲存在 Apple 鑰匙圈；請勿透過電子郵件傳送給支援團隊。"
          }
        }
      }
    },
    "The app will retry automatically, or you can skip to the next photo." : {
      "comment" : "A message that instructs the user that the system will automatically retry and that they can also skip to the next slide.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación lo volverá a intentar automáticamente o puedes pasar a la siguiente foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリは自動的に再試行するか、次の写真にスキップすることもできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统会自动重试，你也可以切到下一张。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統會自動重試，你也可以切到下一張。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統會自動重試，你也可以切到下一張。"
          }
        }
      }
    },
    "The photo list can be read, but photo previews cannot load. Enable asset.view and asset.download for this Immich API Key and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista de fotos se puede leer, pero no se pueden cargar las vistas previas. Activa asset.view y asset.download en esta API Key de Immich e inténtalo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真一覧は読み込めますが、写真プレビューを読み込めません。この Immich API Key で asset.view と asset.download を有効にしてから再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已能读取照片列表，但无法加载照片预览。请在 Immich 的 API Key 权限中启用 asset.view 和 asset.download 后重试。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已能讀取相片列表，但無法載入相片預覽。請在 Immich 的 API Key 權限中啟用 asset.view 和 asset.download 後再試。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已能讀取照片列表，但無法載入照片預覽。請在 Immich 的 API Key 權限中啟用 asset.view 和 asset.download 後重試。"
          }
        }
      }
    },
